<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy to CaneKit/Resources/Secrets.plist (git-ignored) and fill in what you have.
	     VLM_PROVIDER: custom | anthropic | gemini | openai | ondevice. Empty = first provider with a key.
	     Any cloud provider automatically falls back to the on-device describer (Apple Vision +
	     Apple's on-device model) when it fails; with no key at all, on-device is used. -->
	<key>VLM_PROVIDER</key>
	<string>custom</string>

	<!-- Any OpenAI-compatible chat endpoint (Muse 1.3). Base URL without the trailing /chat/completions. -->
	<key>CUSTOM_BASE_URL</key>
	<string></string>
	<key>CUSTOM_API_KEY</key>
	<string></string>
	<key>CUSTOM_MODEL</key>
	<string></string>

	<!-- Natural voice (ElevenLabs). Without a key the app speaks with the system voice. -->
	<key>ELEVENLABS_API_KEY</key>
	<string></string>
	<key>ELEVENLABS_VOICE_ID</key>
	<string>EXAVITQu4vr4xnSDxMaL</string>
	<key>ELEVENLABS_MODEL</key>
	<string>eleven_flash_v2_5</string>

	<key>ANTHROPIC_API_KEY</key>
	<string></string>
	<key>ANTHROPIC_MODEL</key>
	<string>claude-opus-5</string>

	<key>GEMINI_API_KEY</key>
	<string></string>
	<key>GEMINI_MODEL</key>
	<string>gemini-2.5-flash</string>

	<key>OPENAI_API_KEY</key>
	<string></string>
	<key>OPENAI_MODEL</key>
	<string>gpt-4o-mini</string>

	<!-- Grok Bot routine "OpenCane cane events" (folder opencane-cane-events): the webhook
	     trigger's URL + key, copied from that routine's panel. Empty = family alerts are off
	     (the app says so in Settings instead of failing silently). These two names are also read
	     from the process environment first, so an e2e run can point at a throwaway endpoint. -->
	<key>OPENCANE_GROKBOT_WEBHOOK_URL</key>
	<string></string>
	<key>OPENCANE_GROKBOT_WEBHOOK_KEY</key>
	<string></string>

	<!-- Family-alert context (optional). A cheap text model writes one sentence for the family
	     from the facts the phone had; it lands in the event's extra.ai_context, never in `note`.
	     Empty ALERT_MODEL = the cheapest model of whichever provider has a key above
	     (Anthropic -> custom -> OpenAI). No key at all = alerts carry facts and no sentence.
	     ⚠ ALERT_REASONING_EFFORT is "minimal", not the scene path's "low": measured on the Muse
	     endpoint, "low" costs 7.1 s per alert and "minimal" 2.1 s for an equally good line. -->
	<key>ALERT_MODEL</key>
	<string></string>
	<key>ALERT_REASONING_EFFORT</key>
	<string>minimal</string>

	<!-- Supabase database backend for walker telemetry, emergency medical profile, and mobility stats. -->
	<key>SUPABASE_URL</key>
	<string></string>
	<key>SUPABASE_PUBLISHABLE_KEY</key>
	<string></string>
	<key>SUPABASE_SECRET_KEY</key>
	<string></string>
</dict>
</plist>

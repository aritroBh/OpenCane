<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy to CaneKit/Resources/Secrets.plist (git-ignored) and fill in what you have.
	     VLM_PROVIDER: custom | anthropic | gemini | openai | ondevice. Empty = first provider with a key.
	     Any cloud provider automatically falls back to the on-device describer (Apple Vision +
	     Apple's on-device model) when it fails; with no key at all, on-device is used. -->
	<key>VLM_PROVIDER</key>
	<string>custom</string>

	<!-- Any OpenAI-compatible chat endpoint (Muse 1.3). Base URL without the trailing /chat/completions. -->
	<key>CUSTOM_BASE_URL</key>
	<string></string>
	<key>CUSTOM_API_KEY</key>
	<string></string>
	<key>CUSTOM_MODEL</key>
	<string></string>

	<!-- Natural voice (ElevenLabs). Without a key the app speaks with the system voice. -->
	<key>ELEVENLABS_API_KEY</key>
	<string></string>
	<key>ELEVENLABS_VOICE_ID</key>
	<string>21m00Tcm4TlvDq8ikWAM</string>
	<key>ELEVENLABS_MODEL</key>
	<string>eleven_flash_v2_5</string>

	<key>ANTHROPIC_API_KEY</key>
	<string></string>
	<key>ANTHROPIC_MODEL</key>
	<string>claude-opus-5</string>

	<key>GEMINI_API_KEY</key>
	<string></string>
	<key>GEMINI_MODEL</key>
	<string>gemini-2.5-flash</string>

	<key>OPENAI_API_KEY</key>
	<string></string>
	<key>OPENAI_MODEL</key>
	<string>gpt-4o-mini</string>
</dict>
</plist>
